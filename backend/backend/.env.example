# Secrets and environment-specific values only. Everything else is in config/*.yaml.

# --- Local Postgres (docker compose) -------------------------------------------------------
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rumbo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rumbo:change_me@localhost:5432/rumbo

# --- Supabase (when we move there): replace DATABASE_URL with the Session pooler string ----
# See ../docs/conexion_supabase.md
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:TU_CLAVE@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# --- Supabase Auth -----------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Frontend URL registered in Supabase Auth > URL Configuration > Redirect URLs.
SUPABASE_REDIRECT_URL=http://localhost:3010/auth/callback
# Keep false for local HTTP development; set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false

DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:3010"]
ADMIN_API_KEY=
BCENTRAL_USER=
BCENTRAL_PASSWORD=
# Optional: alternative folder with the YAML config files (default: backend/config)
# CONFIG_DIR=
