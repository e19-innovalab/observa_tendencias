# Secrets and environment-specific values only. Everything else is in config/*.yaml.

# --- Local Postgres (docker compose) -------------------------------------------------------
POSTGRES_USER=rumbo
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rumbo
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rumbo:change_me@localhost:5432/rumbo

# --- Supabase (when we move there): replace DATABASE_URL with the Session pooler string ----
# See ../docs/conexion_supabase.md
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:TU_CLAVE@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

DATABASE_CONNECT_TIMEOUT=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:3010"]
ADMIN_API_KEY=
# Signs login tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = nobody can log in. Changing it logs everyone out.
AUTH_SECRET=
BCENTRAL_USER=
BCENTRAL_PASSWORD=
# Assistant (config/app.yaml -> assistant). Only the one for the chosen provider is needed.
ANTHROPIC_API_KEY=
# Provider local = any OpenAI-compatible chat API. On this computer: Ollama (no key). In the cloud
# there is no Ollama: use a hosted API (Groq, Together, OpenRouter…) with its URL, model and key.
ASSISTANT_LOCAL_API_KEY=
# Optional, per environment (empty = config/app.yaml -> assistant):
ASSISTANT_PROVIDER=      # local | anthropic
ASSISTANT_BASE_URL=      # e.g. https://api.groq.com/openai/v1
ASSISTANT_MODEL=         # a model of that service that supports tool calling
# Optional: alternative folder with the YAML config files (default: backend/config)
# CONFIG_DIR=
